{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter pub get)",
      "Bash(flutter analyze *)",
      "Bash(flutter test *)",
      "Bash(dart run custom_lint)",
      "Bash(dart cli/generation/widget/index.dart *)",
      "Bash(dart cli/generation/service/index.dart *)",
      "Bash(bash tooling/hooks/test-gate.sh *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash tooling/hooks/test-gate.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
