# .env.local — runtime configuration loaded by flutter_dotenv at startup.
#
# WARNING: this file is bundled into the app as an asset (see pubspec.yaml)
# and is readable by anyone who downloads the build. Never put secrets here.
#
# Each backend declared in HttpApiEnum reads `<KEY>_API_URL` and
# `<KEY>_API_SCHEME`. The default `api` backend points to JSONPlaceholder so
# the demo list works out of the box.

# api backend — host only (optionally with :port), no scheme
API_API_URL=jsonplaceholder.typicode.com
# https (default) or http
API_API_SCHEME=https

# default page size used by the Listing widget
ITEM_PER_PAGE=20

# enable or disable logger output (true or false)
LOGGER_DEBUG=true
LOGGER_VERBOSE=false
LOGGER_ERROR=true
